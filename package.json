{
  "name": "postflare",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted social media scheduler that runs entirely on Cloudflare (Workers, D1, R2, Workflows).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cli:build": "node scripts/embed-skill.mjs && tsc -p cli/tsconfig.json",
    "cli:typecheck": "tsc -p cli/tsconfig.test.json",
    "cf-typegen": "wrangler types -c wrangler.jsonc worker/worker-configuration.d.ts"
  },
  "cloudflare": {
    "bindings": {
      "SECRET_KEY": {
        "description": "Optional. A long random string used to encrypt platform tokens. If empty, a key is generated on first run and stored in D1."
      }
    }
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
