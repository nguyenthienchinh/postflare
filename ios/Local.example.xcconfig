// Your signing settings. Copy to Local.xcconfig (git-ignored) and edit, then run `xcodegen generate`.
POSTFLARE_BUNDLE_ID = com.example.postflare
DEVELOPMENT_TEAM = ABCDE12345
// Names of your App Store provisioning profiles (Release builds, scripts/release.sh).
POSTFLARE_APP_PROFILE = Postflare App Store
POSTFLARE_WIDGETS_PROFILE = Postflare Widgets App Store
// Apple ID used by scripts/create-app-record.sh (asc web session); not a build setting Xcode uses.
ASC_WEB_APPLE_ID = you@example.com
