	</dict>
	<key>Includes %lld follow-ups from the original post</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Includes %#@n@ from the original post</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
